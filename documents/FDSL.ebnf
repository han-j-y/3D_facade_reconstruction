(*
  FDSL — façade DSL  (facade_e2e, window_compiler vendor copy)

  A façade = a wall slab, a floor × bay grid, named window types (each a WDSL
  window, see WDSL.ebnf), door types, balcony types (see BDSL.ebnf),
  a placement matrix and fit parameters.
  Two JSON spellings. The photo pipeline writes B. Blender runs A, which
  facade_spec.normalize_facade_spec builds from B at render time.

    A. Compiled façade JSON   schema window_compiler_facade_v1 (§2). Input to
                              facade_compile.compile_facade_scene.
    B. Recovery DSL JSON      schema facade_recovery_dsl_v1 (§3). Written as
                              facade_dsl.json. With --with-balconies the same
                              schema is written as facade_dsl_with_balconies.json
                              (balcony_types + layout.balconies added).

  World coordinates (Blender): X across the façade, centred at 0; Z up, 0 at
  ground; Y depth, wall front face at wall.base_front_y. Grid rows are listed
  TOP → BOTTOM. The camera sits on +Y looking −Y, so with mirror_x=true photo-left
  columns stay image-left (world X is negated).
  Image coordinates (B): pixels, x right, y down.
*)


(* ================================================================
   §1  Shared JSON items
   JSON objects are written  { "key": value, ... }  ; [ ] marks optional keys.
   ================================================================ *)

json_number   = ? JSON number ? ;
json_int      = ? JSON integer ? ;
json_bool     = "true" | "false" ;
json_string   = ? JSON string ? ;
type_name     = json_string ;             (* window type, e.g. "win_type_00" *)
door_name     = json_string ;             (* door type, "d" + 2 digits, e.g. "d00" *)
cell_token    = type_name | door_name | empty_token ;
empty_token   = "null" | '""' | '"empty"' | '"spacer"' | '"s"' | '"null"' ;
door_shape    = '"rectangle"' | '"arched"' ;
                (* only "arched" produces an arch; any other value → rectangle *)
window_ir     = ? WDSL.ebnf §2 window_ir ? ;
balcony_ir    = ? BDSL.ebnf compiled JSON IR ? ;
balcony_name  = json_string ;             (* "balc_type_00", "balc_<token>", "balc_enclosed" *)


(* ================================================================
   §2  Compiled façade JSON  (A, normative scene input)
   ================================================================ *)

facade_ir     = "{", '"type": "facade"',
                     [ ',"schema": "window_compiler_facade_v1"' ],
                     [ ',"wall": ', wall ],
                     ',"grid": ', grid,
                     ',"placement": ', matrix_tok,
                     [ ',"placement_spans": ', matrix_int ],
                     [ ',"placement_fit": ', matrix_fit ],
                     ',"windows": {', [ type_name, ": ", window_ir, { ",", type_name, ": ", window_ir } ], "}",
                     [ ',"doors": {', [ door_name, ": ", door_def, { ",", door_name, ": ", door_def } ], "}" ],
                     [ ',"balconies": {', [ balcony_name, ": ", balcony_ir, { ",", balcony_name, ": ", balcony_ir } ], "}" ],
                     [ ',"balcony_placement": [', [ compiled_balcony, { ",", compiled_balcony } ], "]" ],
                     [ ',"instances": [', [ instance, { ",", instance } ], "]" ],
                     [ ',"floor_ids": [', json_int, { ",", json_int }, "]" ],
                     [ ',"image_extent": ', image_extent ],
                     [ ',"placement_params": ', placement_params ],
                     [ ',"meta": ', facade_meta ],
                "}" ;

wall          = "{", [ '"depth": ', json_number ],            (* default 0.42 m *)
                     [ ',"base_front_y": ', json_number ],    (* default 0 *)
                     [ ',"material": ', json_string ],        (* default "wall" *)
                "}" ;

grid          = "{", '"rows": [', row, { ",", row }, "]",     (* top → bottom *)
                     ',"cols": [', col, { ",", col }, "]",    (* left → right *)
                "}" ;
row           = "{", '"name": ', json_string, ',"h": ', json_number, "}" ;   (* metres *)
col           = "{", '"name": ', json_string, ',"w": ', json_number, "}" ;   (* metres *)

matrix_tok    = "[", tok_row, { ",", tok_row }, "]" ;       (* n_rows × n_cols *)
tok_row       = "[", cell_token, { ",", cell_token }, "]" ;
matrix_int    = "[", "[", json_int, { ",", json_int }, "]", { ",", "[", json_int, { ",", json_int }, "]" }, "]" ;
                (* span k ≥ 1 at the first cell of a window covering k bays; the k−1
                   covered cells hold token null and span 0. Missing → 1 (0 if empty). *)
matrix_fit    = "[", fit_row, { ",", fit_row }, "]" ;
fit_row       = "[", ( cell_fit | "null" ), { ",", ( cell_fit | "null" ) }, "]" ;
cell_fit      = "{", '"width_ratio": ', json_number,        (* box width  / cell width  *)
                     ',"height_ratio": ', json_number,      (* box height / cell height *)
                     ',"cx_ratio": ', json_number,          (* box centre x in cell, 0 = left *)
                     ',"cy_ratio": ', json_number,          (* box centre y in cell, 0 = top  *)
                     [ ',"box_aspect": ', json_number ], "}" ;
                (* cell = the grid cell, or the merged cells for a span. Ratios are
                   clamped to [0.05, 0.98] (size) and [0.02, 0.98] (centre). *)

door_def      = "{", [ '"type_id": ', json_int ], [ ',"kind": "door"' ],
                     ',"shape": ', door_shape,
                     [ ',"primitive": ', door_shape ],
                     [ ',"arch_rise_ratio": ', json_number ],  (* rise ÷ width on the photo crop *)
                     [ ',"material": ', json_string ],         (* informational *)
                     [ ',"placeholder": ', json_bool ], "}" ;

placement_params = "{", [ '"width_ratio": ', json_number ],     (* default 0.55  fallback fit *)
                        [ ',"height_ratio": ', json_number ],   (* default 0.60  fallback fit *)
                        [ ',"recess": ', json_number ],         (* default 0.01 m, windows/doors set back *)
                        [ ',"mirror_x": ', json_bool ],         (* default true *)
                        [ ',"unify_type_size": ', json_bool ],  (* default true, see §5 *)
                        [ ',"align_type_bottom": ', json_bool ],(* default true, see §5 *)
                        [ ',"bottom_margin_ratio": ', json_number ], (* accepted, currently unused *)
                   "}" ;

image_extent  = "{", '"x0": ', json_number, ',"x1": ', json_number,
                     ',"y0": ', json_number, ',"y1": ', json_number, "}" ;   (* pixels *)
facade_meta   = "{", [ '"type_ratios": {', type_name, ': {"width_ratio": ', json_number,
                       ', "height_ratio": ', json_number, "}", { "," , "..." }, "}" ],
                     [ ',"facade_id": ', json_string ], [ ',"image_size": [w, h]' ],
                     [ ',"columns_xy": ...' ], [ ',"floors_y": ...' ], "..." , "}" ;
compiled_balcony = "{", '"row": ', json_int,             (* grid row, 0 = top floor *)
                     ',"col0": ', json_int, ',"col1": ', json_int,  (* inclusive column span *)
                     ',"type": ', balcony_name,
                     [ ',"width_norm": ', json_number ],
                     [ ',"cx_norm": ', json_number ],
                     [ ',"window_cx_norm": ', json_number ],
                     [ ',"bay_cx_norm": ', json_number ],
                     [ ',"bays": [', json_int, { ",", json_int }, "]" ],
                     [ ',"bays_center": [', json_int, { ",", json_int }, "]" ],
                "}" ;
(* Copied from B by normalize_facade_spec (§4). row/col0/col1 are grid indices,
   not layout floor/bay ids. *)

(* instances / floor_ids are carried over from B (§3). floor_ids[r] is the floor
   id of grid row r; the ground floor is max(floor_ids). *)


(* ================================================================
   §3  Recovery DSL JSON  (B, pipeline output and hand-edited file)
   ================================================================ *)

recovery_dsl  = "{", '"schema": "facade_recovery_dsl_v1"',
                     ',"meta": ', recovery_meta,
                     ',"layout": ', layout,
                     ',"window_types": [', [ window_type, { ",", window_type } ], "]",
                     [ ',"door_types": [', [ door_type, { ",", door_type } ], "]" ],
                     [ ',"balcony_types": [', [ balcony_type, { ",", balcony_type } ], "]" ],
                     ',"instances": [', [ instance, { ",", instance } ], "]",
                "}" ;

recovery_meta = "{", [ '"facade_id": ', json_string ],
                     [ ',"image": ', json_string ],          (* photo path; absent → no photo panels *)
                     ',"image_size": [', json_int, ",", json_int, "]",   (* [w, h] px *)
                     [ ',"columns_xy": [', px_band, { ",", px_band }, "]" ],   (* one [x0,x1] per bay *)
                     [ ',"floors_y": [', px_band, { ",", px_band }, "]" ],     (* one [y0,y1] per floor, top first *)
                     [ ',"inter_bay_gaps_px"' | ',"inter_bay_gap_norm"'
                       | ',"inter_floor_gaps_px"' | ',"inter_floor_gap_norm"', ": [...]" ],
                     [ ',"synthetic": true' ],               (* template-instantiated *)
                     [ ',"n_units" | "n_types" | "n_doors" | "n_door_types"'
                       | ',"n_balcony_units" | "n_balcony_types"'
                       | ',"balcony_center_mode"' | ',"notes" | ...' ],
                     (* balcony_center_mode: "window" | "bay" | "photo".
                        Enclosed volumes force "bay" when the run asked for "window". *)
                "}" ;
px_band       = "[", json_number, ",", json_number, "]" ;

layout        = "{", '"floors": [', floor, { ",", floor }, "]",     (* top → bottom *)
                     ',"bays": [', bay, { ",", bay }, "]",          (* left → right *)
                     ',"placement": ', matrix_tok,                  (* n_floors × n_bays *)
                     [ ',"placement_spans": ', matrix_int ],
                     [ ',"balconies": [', [ balcony_instance, { ",", balcony_instance } ], "]" ],
                "}" ;
floor         = "{", '"name": ', json_string, ',"id": ', json_int,
                     ',"h_norm": ', json_number,                    (* relative height *)
                     [ ',"h_m": ', json_number ],                   (* metres, see §4 *)
                     [ ',"archetype": ', json_string ], "}" ;       (* set by facade_template.py *)
bay           = "{", '"name": ', json_string, ',"id": ', json_int,
                     ',"w_norm": ', json_number,
                     [ ',"w_m": ', json_number ],
                     [ ',"symbol": ', json_string ], "}" ;

window_type   = "{", '"type_id": ', json_int,
                     [ ',"name": ', type_name ],                    (* default "win_type_%02d" *)
                     ',"structure_ir": ', ( window_ir | '{"ir": ', window_ir, "}" ),
                     [ ',"structure_tokens": [', json_string, { ",", json_string }, "]" ],  (* WDSL §4 *)
                     [ ',"n_instances" | "exemplar_unit" | "exemplar_asset"
                        | "structure_vote" | "structure_members": ...' ],   (* informational *)
                "}" ;
(* Only structure_ir is compiled. A type without a valid structure_ir keeps its
   placement cells but is skipped by Blender. *)

door_type     = "{", '"type_id": ', json_int, [ ',"name": ', door_name ],
                     [ ',"kind": "door"' ], [ ',"shape": ', door_shape ],
                     [ ',"primitive": ', door_shape ], [ ',"arch_rise_ratio": ', json_number ],
                     [ ',"material": ', json_string ],
                     [ ',"n_instances" | "exemplar_asset": ...' ], "}" ;

instance      = "{", '"box_xyxy": [x0, y0, x1, y1]',                (* pixels *)
                     ',"floor": ', json_int,                        (* layout.floors[].id *)
                     ',"bay": ', json_int,                          (* first bay index *)
                     [ ',"colspan": ', json_int ],                  (* default 1 *)
                     ',"type_id": ', json_int,
                     [ ',"kind": ', ( '"window"' | '"door"' ) ],    (* default window *)
                     [ ',"name": ', door_name ],
                     [ ',"shape": ', door_shape, ',"arch_rise_ratio": ', json_number ],
                                                                    (* door: overrides its type *)
                     [ ',"unit_id" | "asset" | "is_exemplar" | "score" | "member_raw_idxs"
                        | "structure_tokens" | "structure_ir" | "structure_ir_member"
                        | "structure_tokens_voted" | "shape_metrics": ...' ],  (* informational *)
                "}" ;

balcony_type  = "{", '"type_id": ', json_int,
                     ',"name": ', balcony_name,
                     ',"structure_ir": ', balcony_ir,               (* BDSL JSON; this is what compiles *)
                     [ ',"n_instances": ', json_int ],
                     [ ',"exemplar_unit": ', json_int ],
                     [ ',"exemplar_asset": ', json_string ],
                     [ ',"structure_tokens": [', json_string, { ",", json_string }, "]" ],
                     [ ',"structure_vote": ', "{", "..." , "}" ],
                "}" ;
(* Written by balcony_pipeline onto a copy of the window recovery DSL.
   Names: "balc_type_%02d" (voted type), "balc_<token>" (per-unit railing
   or floor), "balc_enclosed" (type_id 1000, one plan per photo). *)

balcony_instance = "{", '"floor": ', json_int,                 (* layout.floors[].id *)
                     ',"bay_start": ', json_int, ',"bay_end": ', json_int,
                     ',"bays": [', json_int, { ",", json_int }, "]",
                     ',"bays_center": [', json_int, { ",", json_int }, "]",
                     ',"bay": ', json_int,
                     ',"type": ', balcony_name,                 (* balcony_types[].name *)
                     ',"box_xyxy": [x0, y0, x1, y1]',          (* pixels *)
                     [ ',"width_norm": ', json_number ],       (* photo width ÷ image width; omitted on enclosed volumes *)
                     [ ',"cx_norm": ', json_number ],          (* center mode photo *)
                     [ ',"bay_cx_norm": ', json_number ],      (* center mode bay, and enclosed volumes *)
                     [ ',"window_cx_norm": ', json_number ],   (* center mode window *)
                     [ ',"partner_window_unit_ids": [', json_int, { ",", json_int }, "]" ],
                "}" ;
(* One record per placed balcony. type must name a balcony_types entry or
   normalize_facade_spec drops it. Window placement tokens do not name balcony types. *)

(* Placement tokens name a window type (name, "win_type_%02d" or type id) or a
   door type ("d%02d"); unknown names are dropped with a warning. *)


(* ================================================================
   §4  Recovery DSL → compiled façade  (normalize_facade_spec)
   ================================================================ *)
(*
  Grid size
    If every floor has h_m and every bay has w_m:
        rows[r].h = h_m,  cols[c].w = w_m                  (metric DSL)
    else
        total_h = storey_height (3.0 m) × n_floors,  rows ∝ h_norm
        aspect  = (columns_xy span) / (floors_y span), else image w/h
        total_w = total_h × aspect  (or --facade-width),   cols ∝ w_norm
  Windows / doors
    window_types[].structure_ir → windows{name};  door_types → doors{name}
  Placement
    layout.placement / placement_spans copied (tokens resolved to names).
  Balconies
    balcony_types[].structure_ir → balconies{name}
      (missing name → "balc_type_%02d" from type_id).
    Each layout.balconies record whose type is in that library becomes one
    balcony_placement: row = index of the floor id, col0/col1 = column indices
    of bay_start and bay_end (swapped if reversed). width_norm, cx_norm,
    window_cx_norm, bay_cx_norm, bays, and bays_center are copied when present.
    partner_window_unit_ids stays on B.
  Fits
    For each instance: cell = columns_xy[bay .. bay+colspan−1] × floors_y[row]
    → placement_fit[row][bay] (cell_fit, §2). type_ratios = mean fit per type.
  Carried over: instances, floor_ids (= layout.floors[].id), image_extent
    (columns_xy / floors_y outer bounds), meta.columns_xy / floors_y / image_size.
  Defaults: wall {depth 0.42, base_front_y 0, material "wall"},
    placement_params {width_ratio 0.55, height_ratio 0.60, recess 0.01,
    mirror_x true}.
*)


(* ================================================================
   §5  Placement semantics  (facade_compile.compile_facade_scene)
   ================================================================ *)
(*
  Cells
    Column c spans X from −total_w/2 + Σw[<c] (negated when mirror_x); row r
    spans Z from total_h − Σh[≤r] to total_h − Σh[<r]. A span merges columns.
  Window box (per placed cell)
    fit = instance fit (placement_fit or instance box in its cell)
          else placement_fit cell, else {type_ratios or width/height_ratio, centred}.
    ww = cell.w·width_ratio,  hh = cell.h·height_ratio   (min 0.15 m)
    x  = cell.x0 + cx_ratio·cell.w (flipped within the cell when mirror_x)
    z  = cell.z1 − cy_ratio·cell.h                     (box centre)
  Type regularisation (windows only)
    unify_type_size   : every window of a (type, span) group gets the group's
                        median width and height, keeping its centre.
    align_type_bottom : every window of a (row, type) group gets the group's
                        median bottom Z.
  Window build
    The WDSL IR is refitted to (ww, hh) (WDSL §5) and built at (x0, front−recess, z0).
    Opening = boundary contour (box for rectangles), grown ~5 mm.
  Doors
    width = max(0.25, ww);  top = z0 + max(0.35, hh)
    bottom = 0 on the ground floor (max floor id), else max(0, z0)
    arched iff shape == "arched" and arch_rise_ratio > 0.02:
      r = min(0.5, 2·arch_rise_ratio), snapped to 0.5 when ≥ 0.42
      rise = min(r·width, 0.6·height)
    An instance's shape / arch_rise_ratio overrides its door type.
    Built as frame ring + single wood panel + threshold; opening follows the
    door outline (arched prism or box).
*)
