# T muntin: full horizontal bar + vertical stem in the lower pane only

window rectangle(1.0, 1.4)

frame thickness 0.06*min_side depth 0.08 material painted_wood

regions:
  glass = inset(root, 0.06*min_side)

panes glass:
  @root root
  root split(h=0.55) BOT TOP
  TOP eps
  BOT split(v=0.5) L R
  L eps
  R eps

output:
  muntin_width 0.022*min_side
  muntin_depth 0.035
  glass_thickness 0.01
