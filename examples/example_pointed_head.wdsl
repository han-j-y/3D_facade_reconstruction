# Pointed head = head_body with trapezoid head, top_width=0

window head_body(width=1.0, body=1.1, head=trapezoid, head_height=0.45, top_width=0)

frame thickness 0.07*min_side depth 0.08 material painted_wood

regions:
  glass = inset(root, 0.07*min_side)

program:
  grid glass 2x1

output:
  muntin_width 0.022*min_side
  muntin_depth 0.035
  glass_thickness 0.01
