# head_body with grid on full glass — muntins span head + body

window head_body(width=1.0, body=1.3, head=semicircle, head_height=0.5)

frame thickness 0.06*min_side depth 0.08 material painted_wood

regions:
  glass = inset(root, 0.06*min_side)

program:
  grid glass 2x2

output:
  muntin_width 0.022*min_side
  muntin_depth 0.035
  glass_thickness 0.01
