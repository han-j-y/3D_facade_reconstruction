# Fixed window: rect body + eyebrow springline head

window arch_head(width=1.0, body=1.0, rise=0.24)

frame thickness 0.06*min_side depth 0.08 material painted_wood

regions:
  glass = inset(root, 0.06*min_side)
  body = body(glass)
  head = head(glass)
  center_low = crop(body, 0.333, 0, 0.667, 0.5)
  center_mid = crop(body, 0.333, 0.5, 0.667, 1)
  center_head = crop(head, 0.333, 0, 0.667, 1)

program:
  split_h glass 0.333
  split_v glass 0.333
  split_v glass 0.667
  seam body
  split_v center_low 0.5
  arc center_mid hub origin 0.5 0 eyebrow 0.10*min_side
  split_v center_head 0.5

output:
  muntin_width 0.022*min_side
  muntin_depth 0.035
  glass_thickness 0.01
