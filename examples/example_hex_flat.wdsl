# Hexagon with flat top/bottom (orient=flat) + full-glass grid

window polygon(sides=6, size=1.0, orient=flat)

frame thickness 0.06*min_side depth 0.08 material painted_wood

regions:
  glass = inset(root, 0.06*min_side)

program:
  grid glass 1x1

output:
  muntin_width 0.022*min_side
  muntin_depth 0.035
  glass_thickness 0.01
