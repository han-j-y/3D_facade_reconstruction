# Round-arch head + rectangular body

window head_body(width=1.0, body=1.2, head=semicircle, head_height=0.5)

frame thickness 0.07*min_side depth 0.08 material painted_wood

regions:
  glass = inset(root, 0.07*min_side)
  body = body(glass)

program:
  seam body
  grid body 2x1

output:
  muntin_width 0.022*min_side
  muntin_depth 0.035
  glass_thickness 0.01
