# head_body combination — semicircle head on rectangular body (boundary only)

window head_body(width=1.0, body=1.4, head=semicircle, head_height=0.5)

frame thickness 0.06*min_side depth 0.08 material painted_wood

regions:
  glass = inset(root, 0.06*min_side)

output:
  muntin_width 0.022*min_side
  muntin_depth 0.035
  glass_thickness 0.01
