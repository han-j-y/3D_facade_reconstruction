# Pointed profile — trapezoid with top_width=0

window trapezoid(width=1.0, height=1.2, top_width=0)

frame thickness 0.06*min_side depth 0.08 material painted_wood

regions:
  glass = inset(root, 0.06*min_side)

program:
  split_h glass 0.45

output:
  muntin_width 0.022*min_side
  muntin_depth 0.035
  glass_thickness 0.01
